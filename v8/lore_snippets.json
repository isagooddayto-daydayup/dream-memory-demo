{
  "version": "lore_snippets_20261029",
  "created_beijing": "2026-10-29 09:18 Asia/Shanghai",
  "note": "可随机抽的短感官句，供回忆卡/环境旁白/阿澄闲聊加权。公开安全：无 YY 真名。仅 v8work。",
  "tags": [
    "煤灰",
    "锈铁",
    "雨",
    "广播",
    "车站",
    "小卖",
    "家",
    "雾"
  ],
  "snippets": [
    {
      "id": "s01",
      "tags": [
        "煤灰"
      ],
      "text": "袖口蹭过煤堆，细灰在指缝里发亮。"
    },
    {
      "id": "s02",
      "tags": [
        "煤灰"
      ],
      "text": "风一转，嘴里有股淡淡的煤腥。"
    },
    {
      "id": "s03",
      "tags": [
        "煤灰"
      ],
      "text": "窗台灰被雨冲出两道深浅痕。"
    },
    {
      "id": "s04",
      "tags": [
        "煤灰"
      ],
      "text": "矿车踏板上积着一层黑，踩上去吱一声。"
    },
    {
      "id": "s05",
      "tags": [
        "煤灰"
      ],
      "text": "小孩裤脚边总嵌着洗不净的灰线。"
    },
    {
      "id": "s06",
      "tags": [
        "锈铁"
      ],
      "text": "雨棚铁皮补丁叠补丁，锈成暗红。"
    },
    {
      "id": "s07",
      "tags": [
        "锈铁"
      ],
      "text": "拉环冰凉，锈屑沾在掌心。"
    },
    {
      "id": "s08",
      "tags": [
        "锈铁"
      ],
      "text": "栏杆漆皮翻卷，露出底下的褐斑。"
    },
    {
      "id": "s09",
      "tags": [
        "锈铁"
      ],
      "text": "站牌螺丝松了，风里轻轻磕。"
    },
    {
      "id": "s10",
      "tags": [
        "锈铁"
      ],
      "text": "铁皮门一关，整条巷子跟着嗡一下。"
    },
    {
      "id": "s11",
      "tags": [
        "雨"
      ],
      "text": "雨丝斜着切过路灯光锥。"
    },
    {
      "id": "s12",
      "tags": [
        "雨"
      ],
      "text": "檐水打在空铁桶上，像慢节拍。"
    },
    {
      "id": "s13",
      "tags": [
        "雨"
      ],
      "text": "积水里倒映出门楣，又被脚步搅碎。"
    },
    {
      "id": "s14",
      "tags": [
        "雨"
      ],
      "text": "雨夜雾贴着屋顶走，远山只剩剪影。"
    },
    {
      "id": "s15",
      "tags": [
        "雨"
      ],
      "text": "伞骨锈住了，撑开时咔一声。"
    },
    {
      "id": "s16",
      "tags": [
        "雨"
      ],
      "text": "雨停后的石头还在冒白气。"
    },
    {
      "id": "s17",
      "tags": [
        "广播"
      ],
      "text": "广播嘶一声，吐出半句「请旅客注意」。"
    },
    {
      "id": "s18",
      "tags": [
        "广播"
      ],
      "text": "地方戏曲拖腔被雷掐断在半句。"
    },
    {
      "id": "s19",
      "tags": [
        "广播"
      ],
      "text": "喇叭里的普通话带着电流沙。"
    },
    {
      "id": "s20",
      "tags": [
        "广播"
      ],
      "text": "到站名含糊不清，像故意不让你听真。"
    },
    {
      "id": "s21",
      "tags": [
        "广播"
      ],
      "text": "收音机串台，新闻和广告叠在一起。"
    },
    {
      "id": "s22",
      "tags": [
        "车站"
      ],
      "text": "站牌背面白漆下，隐约是一九八七。"
    },
    {
      "id": "s23",
      "tags": [
        "车站"
      ],
      "text": "灯牌跳成「即将发车」，矮栏边有人跺脚。"
    },
    {
      "id": "s24",
      "tags": [
        "车站"
      ],
      "text": "矿车门哐地合上，风灌进车厢。"
    },
    {
      "id": "s25",
      "tags": [
        "车站"
      ],
      "text": "时刻表被铁丝绑在柱上，字迹发黄。"
    },
    {
      "id": "s26",
      "tags": [
        "车站"
      ],
      "text": "检票口没有闸机，只有一句口头放行。"
    },
    {
      "id": "s27",
      "tags": [
        "小卖"
      ],
      "text": "汽水瓶壁起雾，凉意从指尖爬上来。"
    },
    {
      "id": "s28",
      "tags": [
        "小卖"
      ],
      "text": "油纸包着面包，甜里掺一点樟脑味。"
    },
    {
      "id": "s29",
      "tags": [
        "小卖"
      ],
      "text": "柜台灯是广场上最暖的一块。"
    },
    {
      "id": "s30",
      "tags": [
        "小卖"
      ],
      "text": "价签发黄，数字被人用圆珠笔改过。"
    },
    {
      "id": "s31",
      "tags": [
        "小卖"
      ],
      "text": "抽屉里一枚铝币，响得很轻。"
    },
    {
      "id": "s32",
      "tags": [
        "家"
      ],
      "text": "日历停在某个不重要的日子。"
    },
    {
      "id": "s33",
      "tags": [
        "家"
      ],
      "text": "油灯一亮，窗外煤灰巷子淡下去。"
    },
    {
      "id": "s34",
      "tags": [
        "家"
      ],
      "text": "床沿坐久了，雨声会变清楚。"
    },
    {
      "id": "s35",
      "tags": [
        "家"
      ],
      "text": "墙上只有水渍和影子，没有脸。"
    },
    {
      "id": "s36",
      "tags": [
        "雾"
      ],
      "text": "冷灰雾从站台缝里渗进来。"
    },
    {
      "id": "s37",
      "tags": [
        "雾"
      ],
      "text": "雾里路灯晕成一团毛边。"
    },
    {
      "id": "s38",
      "tags": [
        "煤灰",
        "雨"
      ],
      "text": "雨把煤灰冲进沟里，黑水慢慢走。"
    },
    {
      "id": "s39",
      "tags": [
        "锈铁",
        "雨"
      ],
      "text": "锈水顺着铁皮滴进泥里，一圈一圈。"
    },
    {
      "id": "s40",
      "tags": [
        "广播",
        "雾"
      ],
      "text": "雾浓时广播更远，像从井底喊上来。"
    }
  ]
}